{
  "name": "apitech-can-education",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:education",
    "dev:education": "npm run dev --workspace=@apitech/education-web",
    "dev:admin": "npm run dev --workspace=@apitech/admin-web",
    "dev:api": "npm run dev --workspace=@apitech/api",
    "dev:all": "concurrently --kill-others-on-fail --names education,admin,api \"npm:dev:education\" \"npm:dev:admin\" \"npm:dev:api\"",
    "build": "npm run build --workspace=@apitech/contracts && npm run build:api && npm run build:education && npm run build:admin",
    "build:education": "npm run build --workspace=@apitech/education-web",
    "build:admin": "npm run build --workspace=@apitech/admin-web",
    "build:api": "npm run build --workspace=@apitech/api",
    "lint": "oxlint apps packages supabase/tests",
    "preview": "npm run preview --workspace=@apitech/education-web",
    "export:html": "npm run export:html --workspace=@apitech/education-web",
    "test:motor": "npm run test:motor --workspace=@apitech/education-web",
    "test:auth:ui": "npm run test:auth:ui --workspace=@apitech/education-web",
    "test:api": "npm run test --workspace=@apitech/api",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "test:auth:signup": "npm run test:auth:signup --workspace=@apitech/api --",
    "test:auth:status": "npm run test:auth:status --workspace=@apitech/api --",
    "postman:generate": "node tools/postman/generate.mjs --local",
    "test:postman": "node --test tools/postman/tests/*.test.mjs",
    "dev:reset-admin-password": "npm run dev:reset-admin-password --workspace=@apitech/api --"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "concurrently": "^10.0.7",
    "oxlint": "^1.89.0"
  }
}
