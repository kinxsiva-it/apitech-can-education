PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Required for member endpoints. With neither value set, health still works;
# member endpoints return 503. Fill in both values before using them.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Server secrets must never use the VITE_ prefix or be shared with a frontend.

# Optional Dev-only password reset target (never used by API routes).
DEV_ADMIN_USER_ID=
DEV_ADMIN_EMAIL=

# Optional email worker only. Never copy these secrets into a VITE_ variable.
MEMBERSHIP_EMAIL_ENABLED=false
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EDUCATION_SITE_URL=http://localhost:5173
