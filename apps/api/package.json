{
  "name": "@apitech/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && concurrently --kill-others-on-fail --names compiler,server \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@apitech/contracts": "0.0.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/platform-express": "^12.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "typescript": "~7.0.2"
  }
}
