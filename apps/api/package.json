{
  "name": "@apitech/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && concurrently --kill-others-on-fail --names compiler,server \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:auth:signup": "node scripts/auth-smoke.mjs signup",
    "test:auth:status": "node scripts/auth-smoke.mjs status",
    "dev:reset-admin-password": "node scripts/reset-admin-password.mjs"
  },
  "dependencies": {
    "@apitech/contracts": "0.0.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@supabase/supabase-js": "^2.119.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "typescript": "~7.0.2"
  }
}
